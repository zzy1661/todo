{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "日程待办",
  "version": "0.1.0",
  "identifier": "com.poisson.todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "日程待办",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:todo.db"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "本地日程与待办，日历、每日工作法、全部待办三模块",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
